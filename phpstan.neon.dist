parameters:
    phpVersion: 80500
    level: 5
    paths:
        - nginx/web
        - nginx/tests
    excludePaths:
        - nginx/web/config.php (?)
        - nginx/web/public/graphs.php
    ignoreErrors:
        -
            message: '#might not be defined#'
            path: nginx/web/public/*
        -
            message: '#will always evaluate to true#'
            identifier: staticMethod.alreadyNarrowedType
            path: nginx/tests/*
