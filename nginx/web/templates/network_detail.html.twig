{% extends "base.html.twig" %}

{% set graphs = [
	{ title: 'Routers by country code', type: 'cc', label: 'Routers', wide: true },
	{ title: 'Exit routers by country code', type: 'cc_exit', label: 'Exit routers', wide: true },
	{ title: 'Routers by uptime', type: 'uptime', label: 'Routers', wide: true },
	{ title: 'Routers by observed bandwidth', type: 'bandwidth', label: 'Routers' },
	{ title: 'Routers by platform', type: 'platform', label: 'Routers' },
	{ title: 'Routers matching specified criteria', type: 'summary', label: 'Routers', wide: true },
] %}

{% block content %}
<section class="ts-hero">
	<div>
		<p class="ts-eyebrow">Network</p>
		<h1>Graphs</h1>
		<p class="ts-muted">Country, uptime, bandwidth, platform and summary graphs generated from the current cache.</p>
	</div>
	<a href="index.php" class="ts-button ts-button-secondary" title="Return to the router list"><i class="ti ti-list-details" aria-hidden="true"></i>Routers</a>
</section>

<div class="ts-graph-grid">
	{% for graph in graphs %}
	<section class="ts-card ts-graph-card{% if graph.wide|default(false) %} ts-graph-card-wide{% endif %}">
		<h2>{{ graph.title }}</h2>
		<div class="ts-chart-canvas-wrap"><canvas data-chart-endpoint="graphs.php?type={{ graph.type }}" data-chart-type="bar" data-chart-value-label="{{ graph.label }}"></canvas></div>
	</section>
	{% endfor %}
</div>
{% endblock %}
